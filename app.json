{
  "expo": {
    "name": "Président : Nation en Crise",
    "slug": "etat-de-crise",
    "version": "1.0.0",
    "owner": "tiboyboss",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "etat-de-crise",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0c0e"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.etatdecrise.president",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a0c0e"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8ae12bcb-3626-4971-a816-e0fd7949214f"
      }
    }
  }
}
