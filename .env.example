# Copier ce fichier en .env et remplir les valeurs.
# Les variables EXPO_PUBLIC_* sont injectées dans le bundle au moment du build.
# Ne jamais committer .env dans git.

# URL de ton serveur backend (sans slash final).
# - Sur Replit : détectée automatiquement via REPLIT_DOMAINS, cette variable est optionnelle.
# - En build natif EAS (Android/iOS) : obligatoire, pointer vers ton serveur de production.
# Exemple : EXPO_PUBLIC_API_URL=https://mon-api.fly.dev
EXPO_PUBLIC_API_URL=

# Clé publique RevenueCat Android (format : goog_xxxxxxxxxxxxxxxxxxxx).
# Visible dans : RevenueCat Dashboard → Project → API Keys → Public app-specific keys.
# Obligatoire pour activer les achats in-app sur Android natif.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
