# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAT DE CRISE — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copier ce fichier en .env.local et remplir les valeurs réelles.
# Ne jamais committer .env.local dans git (protégé par .gitignore).
#
# Voir docs/env_setup.md pour le guide complet de configuration.
#
# Légende :
#   [OBLIGATOIRE]   — l'app ne fonctionne pas sans cette variable
#   [BUILD NATIF]   — nécessaire uniquement pour un build EAS natif (iOS/Android)
#   [DEVELOPPEMENT] — réservé au développement local, ne jamais activer en production
#   [OPTIONNEL]     — peut rester vide selon la configuration
# ═══════════════════════════════════════════════════════════════════════════════


# ── SUPABASE [OBLIGATOIRE] ────────────────────────────────────────────────────
# URL du projet Supabase.
# Visible dans : Supabase Dashboard → Project Settings → API → Project URL
# Format attendu : https://ABCDEFGHIJ.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Clé anon/publique Supabase.
# Visible dans : Supabase Dashboard → Project Settings → API → anon public
# Cette clé est publique et peut figurer dans le bundle de l'app.
# Ne pas confondre avec la service_role key (secrète, ne jamais l'exposer).
EXPO_PUBLIC_SUPABASE_ANON_KEY=


# ── REVENUECAT [BUILD NATIF] ──────────────────────────────────────────────────
# Clé publique iOS pour les achats in-app (format : appl_xxxxxxxxxxxxxxxxxxxx).
# Visible dans : RevenueCat Dashboard → Project → API Keys → Public app-specific keys
# Obligatoire pour un build EAS iOS natif. Peut rester vide en mode Expo Go.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Clé publique Android pour les achats in-app (format : goog_xxxxxxxxxxxxxxxxxxxx).
# Visible dans : RevenueCat Dashboard → Project → API Keys → Public app-specific keys
# Obligatoire pour un build EAS Android natif. Peut rester vide en mode Expo Go.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=


# ── API [OPTIONNEL] ───────────────────────────────────────────────────────────
# URL de base d'une API custom (sans slash final).
# Laisser vide si tout passe par Supabase Edge Functions.
EXPO_PUBLIC_API_BASE_URL=


# ── MODE DÉVELOPPEUR [DEVELOPPEMENT — JAMAIS EN PRODUCTION] ──────────────────
# Active le sandbox de développement (données de test, logs étendus, etc.).
#
# !! ATTENTION !!
# Cette variable NE DOIT JAMAIS valoir "true" dans un build de production.
# npm run preflight:prod bloque automatiquement le build si elle est active.
# Valeur par défaut : false
EXPO_PUBLIC_ENABLE_DEV_SANDBOX=false
