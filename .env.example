# Copier ce fichier en .env et remplir les valeurs.
# Les variables EXPO_PUBLIC_* sont injectées dans le bundle au moment du build EAS.
# Ne jamais committer .env dans git — il est dans .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# URL du projet Supabase (visible dans Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co

# Clé anon/publique Supabase (visible dans Project Settings > API > anon public).
# Cette clé est publique — elle peut figurer dans le bundle de l'app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── RevenueCat ────────────────────────────────────────────────────────────────
# Clé publique iOS (format : appl_xxxxxxxxxxxxxxxxxxxx).
# Visible dans : RevenueCat Dashboard → Project → API Keys → Public app-specific keys.
# Obligatoire pour activer les achats in-app sur iOS natif (EAS Build).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Clé publique Android (format : goog_xxxxxxxxxxxxxxxxxxxx).
# Visible dans : RevenueCat Dashboard → Project → API Keys → Public app-specific keys.
# Obligatoire pour activer les achats in-app sur Android natif (EAS Build).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ── Optionnel ─────────────────────────────────────────────────────────────────
# URL de base de l'API custom si utilisée (sans slash final).
# Laisser vide si tout passe par Supabase Edge Functions.
EXPO_PUBLIC_API_BASE_URL=
